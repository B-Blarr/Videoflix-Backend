# Repository root. Only patterns that should apply to EVERY part of the
# monorepo belong here. Anything tied to one stack lives beside it:
#
#   backend/.gitignore    Python and Django
#   frontend/.gitignore   Angular and Node
#
# Keep generic folder names such as lib/, build/, dist/, parts/ and var/ out
# of this file. Without a path prefix they match everywhere, which silently
# swallowed frontend/src/app/lib/ before the split.

# Secrets. The template is tracked on purpose, only the real file is ignored.
.env

# Virtual environments, wherever someone creates one.
.venv
venv/
env/
ENV/
env.bak/
venv.bak/

# Logs
*.log

# Operating system clutter
.DS_Store
Thumbs.db
desktop.ini

# Claude Code: working instructions and archive, project internal
CLAUDE.md
CLAUDE.local.md
_archiv/
