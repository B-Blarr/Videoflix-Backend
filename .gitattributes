# =====================================================================
# Line endings
#
# This file is the single source of truth for the repository. It wins
# over whatever core.autocrlf each developer has configured locally.
#
# Reason: scripts and config files run inside the Linux container,
# where CRLF (\r\n) is a real error, e.g. "/bin/sh^M: bad interpreter".
# =====================================================================

# Default: Git detects text files on its own, always stores them with
# LF in the repository and, thanks to eol=lf, checks them out with LF
# on Windows as well.
* text=auto eol=lf

# --- Must be LF (executed or read inside the container) ---
*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.Dockerfile    text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.env.template   text eol=lf

# --- Windows tools expect CRLF ---
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# --- Binary files: Git must never convert these ---
*.png       -text
*.jpg       -text
*.jpeg      -text
*.gif       -text
*.ico       -text
*.webp      -text
*.pdf       -text
*.zip       -text
*.gz        -text
*.mp4       -text
*.mov       -text
*.mkv       -text
*.webm      -text
*.sqlite3   -text
