# This file is used to specify files and directories that should be ignored by Docker when building images.
# It is similar to .gitignore but specific to Docker.
*.pyc
*.pyo
*.mo
*.db
*.css.map
*.egg-info
*.sql.gz
.cache
.project
.idea
.pydevproject
.idea/workspace.xml
.DS_Store
.git/
.sass-cache
.vagrant/
__pycache__
dist
docs
env
venv
logs
src/{{ project_name }}/settings/local.py
src/node_modules
web/media
web/static/CACHE
stats
Dockerfile
.env
db.sqlite3

# =====================================================================
# ERGAENZT: siehe Kommentare unten
# =====================================================================

# Virtuelle Python-Umgebung.
# Die Zeilen "env" / "venv" weiter oben greifen NICHT, weil der Ordner
# hier ".venv" heisst (mit Punkt). Ohne diese Zeile werden ~60 MB
# Windows-Binaries ins Alpine-Linux-Image kopiert - dort nutzlos und
# der Layer-Cache von "COPY . ." wird bei jeder Aenderung ungueltig.
.venv

# Docker-eigene Dateien werden im Image nicht gebraucht.
# Die Zeile "Dockerfile" oben greift nicht, weil die Datei hier
# "backend.Dockerfile" heisst.
*.Dockerfile
docker-compose*.yml
.dockerignore

# Git-Metadaten (".git/" steht bereits oben).
.gitignore
.gitattributes

